{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./data/**)",
      "Read(data/**)",
      "Read(./.env)",
      "Read(.env)",
      "Read(./.env.*)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(secrets/**)",
      "Read(**/secrets/**)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(**/*password*)",
      "Read(**/*token*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/*.sqlite)",
      "Read(**/*.sqlite-wal)",
      "Read(**/*.sqlite-shm)",

      "Edit(./server/**)",
      "Edit(server/**)",
      "Edit(./client/**)",
      "Edit(client/**)",
      "Edit(./data/**)",
      "Edit(data/**)",
      "Edit(./package.json)",
      "Edit(package.json)",
      "Edit(./package-lock.json)",
      "Edit(package-lock.json)",
      "Edit(./deploy/**)",
      "Edit(deploy/**)",
      "Edit(**/install.sh)",

      "Write(./server/**)",
      "Write(server/**)",
      "Write(./client/**)",
      "Write(client/**)",
      "Write(./data/**)",
      "Write(data/**)",
      "Write(./package.json)",
      "Write(package.json)",
      "Write(./package-lock.json)",
      "Write(package-lock.json)",
      "Write(./deploy/**)",
      "Write(deploy/**)",
      "Write(**/install.sh)",

      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
