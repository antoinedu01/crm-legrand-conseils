# Configuration du CRM — copiez ce fichier en `.env` si besoin.
# AUCUNE valeur sensible ne doit être committée dans Git.

# Port d'écoute de l'API (défaut : 3000)
PORT=3000

# Environnement : production | development
NODE_ENV=production

# Dossier des données (base SQLite, secret de session). Défaut : ./data
# CRM_DATA_DIR=/home/crm/app/data

# Secret de session. S'il n'est pas défini, un secret aléatoire est généré
# au premier démarrage et stocké dans data/.session-secret (recommandé).
# SESSION_SECRET=

# (Réservé phase 2 — assistant IA. Ne jamais mettre la clé dans le code.)
# ANTHROPIC_API_KEY=
